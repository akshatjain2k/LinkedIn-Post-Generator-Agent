# Copy this file to .env and fill in your own keys.
# cp .env.example .env

# =============================================================================
# ACTIVE PROVIDER — NVIDIA NIM (native SDK)
# =============================================================================
LLM_PROVIDER=nvidia
LLM_API_KEY=nvapi-...
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.7


# =============================================================================
# EXAMPLE — OpenAI (or any OpenAI-compatible endpoint)
# =============================================================================
# To switch: comment out the ACTIVE block above and uncomment these lines.
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=1
# LLM_TOP_P=0.95
# LLM_BASE_URL=               # leave blank for OpenAI; set for Gemini/Groq/Together etc.
# LLM_ENABLE_THINKING=false   # true only for NVIDIA nemotron via the openai provider path


# =============================================================================
# SEARCH — SerpAPI
# =============================================================================
SERPAPI_API_KEY=your-serpapi-key-here


# =============================================================================
# AGENT BEHAVIOUR
# =============================================================================
MAX_SEARCHES=2
MAX_REVISIONS=1
