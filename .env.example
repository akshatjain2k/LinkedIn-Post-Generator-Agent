# Copy this file to .env and fill in your own keys.
# cp .env.example .env

# =============================================================================
# ACTIVE PROVIDER — OpenAI-compatible endpoint (e.g. Gemini, pure OpenAI, etc.)
# =============================================================================
# Set LLM_PROVIDER=openai to use any OpenAI-compatible API endpoint.
# 
# For Gemini:
#   LLM_BASE_URL = https://generativelanguage.googleapis.com/v1beta/openai/
#
# For pure OpenAI:
#   Leave LLM_BASE_URL commented out or blank.
#
# For Groq/Together/etc.:
#   Set LLM_BASE_URL to their respective OpenAI-compatible endpoint URLs.
#
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.7


# =============================================================================
# EXAMPLE — NVIDIA NIM (native SDK)
# =============================================================================
# To switch to NVIDIA: comment out the ACTIVE block above and uncomment these lines.
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.1-8b-instruct
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.6
# LLM_TOP_P=0.7


# =============================================================================
# SEARCH — SerpAPI
# =============================================================================
SERPAPI_API_KEY=your-serpapi-key-here


# =============================================================================
# AGENT BEHAVIOUR
# =============================================================================
# MAX_SEARCHES: Limit the number of Google searches per run (saves LLM cost/time)
# MAX_REVISIONS: Limit the number of evaluator-driven rewrites
MAX_SEARCHES=2
MAX_REVISIONS=1
